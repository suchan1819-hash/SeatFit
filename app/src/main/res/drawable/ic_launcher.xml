        <path android:fillColor="#FF03201B"
            android:strokeColor="#FF03201B" android:strokeWidth="1.6"
            android:strokeLineJoin="round"
            android:pathData="M5.6,7.0 L10.6,6.4 L12.4,15.2 L7.6,15.8 Z" />
